#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);


#define SERVOMIN  125
#define SERVOMAX  575


int angleToPulse(int angle) {
  angle = constrain(angle, 0, 180);
  return map(angle, 0, 180, SERVOMIN, SERVOMAX);
}

void setup() {
  Serial.begin(115200);
  Serial.setTimeout(5); 

  Wire.begin(8, 9);
  pwm.begin();
  pwm.setPWMFreq(50); 
}

void loop() {
  if (Serial.available() > 0) {
   
    int angleThumb  = Serial.parseInt();
    int angleIndex  = Serial.parseInt();
    int angleMiddle = Serial.parseInt();
    int angleRing   = Serial.parseInt();
    int anglePinky  = Serial.parseInt();

    // Map the last 2 values based on your hardware
    
    int thumbMapped  = map(angleThumb,  120, 160, 160, 0);
    int indexMapped  = map(angleIndex,  112, 145, 0, 100);
    int middleMapped = map(angleMiddle, 100, 145, 0, 110);
    int ringMapped   = map(angleRing,   95, 150, 180, 0);
    int pinkyMapped  = map(anglePinky,  95, 155, 160, 0);

    
    pwm.setPWM(0, 0, angleToPulse(thumbMapped));  
    pwm.setPWM(1, 0, angleToPulse(indexMapped));  
    pwm.setPWM(2, 0, angleToPulse(middleMapped)); 
    pwm.setPWM(3, 0, angleToPulse(ringMapped));   
    pwm.setPWM(4, 0, angleToPulse(pinkyMapped));  

    
    while (Serial.available() > 0) {
      Serial.read();
    }
  }
}